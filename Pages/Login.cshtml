@page
@model Sign_Language_Learning_System.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="sl-auth">
    <div class="sl-card p-0 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5 sl-auth-side">
                <div>
                    <h2 class="mb-3">Welcome back.</h2>
                    <p class="mb-0">Ready for today's five minutes? Your journey is right where you left it.</p>
                </div>
                <div class="sl-placeholder">[Photo: a family signing at the dinner table]</div>
            </div>

            <div class="col-md-7 sl-auth-form">
                <form method="post">
                    <h1 class="h2 mb-1">Log in</h1>
                    <p class="text-muted mb-4">Learners and administrators use the same login.</p>

                    @if (!string.IsNullOrWhiteSpace(Model.AccountMessage))
                    {
                        <div class="alert alert-info" role="status">@Model.AccountMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Message))
                    {
                        <div class="alert alert-danger" role="alert">@Model.Message</div>
                    }

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="username" required placeholder="you@example.com" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>

                    <p class="text-center text-muted mt-4 mb-0">
                        New to SignLearn?
                        <a class="fw-bold" asp-page="/Signup">Create a free account</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
