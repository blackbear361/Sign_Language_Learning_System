@page
@model IndexModel
@{
    ViewData["Title"] = "Sign with the people you love";
    ViewData["FullWidth"] = true;

    var isSignedIn = ViewContext.HttpContext.Session.GetInt32("UserId") is not null;
    // Visitors log in before opening full lessons; members go straight to Lessons.
    var lessonHref = isSignedIn ? "/Lessons" : "/Login";
    var quizHref = isSignedIn ? "/Quiz" : "/Login";

    var topics = new[]
    {
        ("Alphabet", "Spell your name and introduce yourself"),
        ("Numbers", "Prices, phone numbers and the time"),
        ("Greetings", "Hello, thank you and see you soon"),
        ("Family", "Chat with the people closest to you"),
        ("Food", "Order at the café or the mamak"),
        ("Daily Activities", "From your morning coffee to bedtime"),
        ("Common Phrases", "Small talk that makes friends")
    };
}

<!-- Hero -->
<section class="sl-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="sl-eyebrow mb-3">Everyday sign language for beginners</span>
                <h1 class="mb-3">Sign with the people you love.</h1>
                <p class="lead mb-4">Learn the everyday signs you need for the café, the dinner table and everything in between — in short, friendly lessons.</p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a class="btn btn-primary btn-lg" href="@lessonHref">Start learning</a>
                    <a class="btn btn-accent btn-lg" href="@quizHref">Take a quiz</a>
                </div>
                <ul class="sl-dot-list">
                    <li>5 minutes a day</li><li>·</li><li>7 everyday topics</li><li>·</li><li>Free to join</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <!-- Replace with a real photo, e.g. <img src="~/images/hero.jpg" class="w-100 sl-hero-media" style="object-fit:cover" alt="..." /> -->
                <div class="sl-placeholder sl-hero-media">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#B4532C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0v5" /><path d="M14 10V4a2 2 0 0 0-4 0v6" /><path d="M10 10.5V6a2 2 0 0 0-4 0v8" /><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" /></svg>
                    <span>[Photo: two friends signing and laughing over coffee]</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How it fits into your day -->
<section id="how" class="sl-section-white py-5">
    <div class="container py-3">
        <h2 class="mb-4">How it fits into your day</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="sl-card sl-step">
                    <span class="sl-step-num">1</span>
                    <h3 class="h5">Learn</h3>
                    <p class="mb-0 text-muted">Watch a short clip over breakfast and follow the simple steps for each sign.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="sl-card sl-step">
                    <span class="sl-step-num">2</span>
                    <h3 class="h5">Practise</h3>
                    <p class="mb-0 text-muted">Try a two-minute quiz on the bus and get friendly feedback on every answer.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="sl-card sl-step">
                    <span class="sl-step-num">3</span>
                    <h3 class="h5">Track</h3>
                    <p class="mb-0 text-muted">See how far you've come and pick up right where you left off.</p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Call to action -->
@if (!isSignedIn)
{
    <section class="pb-5">
        <div class="container">
            <div class="sl-cta d-flex flex-wrap align-items-center justify-content-between gap-4">
                <div>
                    <h2 class="mb-2">Your first sign is five minutes away.</h2>
                    <p>Join free and learn at your own pace — whenever life gives you a moment.</p>
                </div>
                <a class="btn btn-accent btn-lg" asp-page="/Signup">Start for free</a>
            </div>
        </div>
    </section>
}
