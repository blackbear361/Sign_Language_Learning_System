@page
@model Sign_Language_Learning_System.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sl-page-header">
            <h1>About you</h1>
            <p>Tell us a little about yourself and why you're learning to sign.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @Model.Message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="sl-card sl-card-lg">
            <form method="post">
                <div class="mb-4">
                    <label class="form-label" for="profileEmail">Email address</label>
                    <input id="profileEmail" type="email" class="form-control" value="@Model.Email" disabled aria-describedby="emailHelp" />
                    <div id="emailHelp" class="form-text">Your email address cannot be changed here.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="FullName" class="form-label">Full name</label>
                    <input asp-for="FullName" class="form-control" placeholder="What should we call you?" />
                </div>

                <div class="mb-4">
                    <label asp-for="Bio" class="form-label">Short bio</label>
                    <textarea asp-for="Bio" class="form-control" rows="3" placeholder="A little about you — your hobbies, your day, anything."></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="Phone" class="form-label">Phone number</label>
                    <input asp-for="Phone" type="tel" class="form-control" placeholder="+60 12-345 6789" />
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-4">
                        <label asp-for="DateOfBirth" class="form-label">Date of birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="SkillLevel" class="form-label">Sign language skill level</label>
                        <select asp-for="SkillLevel" class="form-select">
                            <option value="Beginner">Beginner (Complete Newbie)</option>
                            <option value="Intermediate">Intermediate (Know basic fingerspelling)</option>
                            <option value="Advanced">Advanced (Conversational/Fluent)</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-page="/Dashboard" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>

            @if (Model.CanDeactivateAccount)
            {
                <div class="mt-5 pt-4 border-top">
                    <h2 class="h5 text-danger fw-bold">Deactivate account</h2>
                    <p class="text-muted">This signs you out and disables your account. Your profile and learning progress will be kept. Contact an administrator if you want to reactivate your account.</p>
                    <form method="post" asp-page-handler="DeactivateAccount" onsubmit="return confirm('Deactivate your account? You will be signed out, and an administrator will need to reactivate it.');">
                        <button type="submit" class="btn btn-outline-danger">Deactivate my account</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
